# Frontend: leave empty to use the Vite /api proxy locally.
# For a separate deployed Python backend, use its HTTPS origin + /api/v1.
VITE_API_BASE=
# Backend: unset for SQLite; compose uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://tripcanvas:change-me@localhost:5432/tripcanvas
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=0
# Configure a provider supporting the chat/completions JSON protocol.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
AMAP_WEB_KEY=
