# Frontend: leave empty to use the Vite /api proxy locally.
# For a separate deployed Python backend, use its HTTPS origin + /api/v1.
VITE_API_BASE=
# Backend: unset for SQLite; compose uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://tripcanvas:change-me@localhost:5432/tripcanvas
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=0
# Configure a provider supporting the chat/completions JSON protocol.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
# Public backend HTTPS origin for the JS security-code proxy
PUBLIC_API_ORIGIN=
# Set all three keys to enable AMAP; osrm explicitly retains the older provider.
ROUTING_PROVIDER=auto
# Persistent request budgets, conservatively below personal account quotas.
AMAP_LBS_MONTHLY_LIMIT=10000
AMAP_LBS_DAILY_LIMIT=500
AMAP_SEARCH_MONTHLY_LIMIT=1000
AMAP_SEARCH_DAILY_LIMIT=100
# Railway: use the Postgres service's DATABASE_URL and your exact Sites origin.
# FRONTEND_ORIGINS=https://tripcanvas-shitu-melody.yuchangceng065.chatgpt.site
# COOKIE_SECURE=1
# Optional self-hosted/contracted OSRM origins (server-side only):
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
# Model providers (OpenAI-compatible chat/completions with JSON output).
# BigModel China (official free GLM-4.7-Flash):
#   MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   MODEL_NAME=glm-4.7-flash
#   MODEL_API_KEY=<your BigModel China API key, server only>
# Keep PLANNER_MODE=rules until the provider check succeeds; then set auto.
# Z.AI: free flash model is glm-4.7-flash; glm-5.1 is the paid flagship.
#   MODEL_BASE_URL=https://api.z.ai/api/paas/v4
#   MODEL_NAME=glm-4.7-flash
# OpenRouter (paid GLM-5.1, no free variant at the time of writing):
#   MODEL_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_NAME=z-ai/glm-5.1
# AIHubMix free trial model (quota exhausted once; needs a recharged/trial account):
#   MODEL_BASE_URL=https://aihubmix.com/v1
#   MODEL_NAME=coding-glm-5.1-free
# MODEL_API_KEY=
# PHOTON_URL=https://photon.komoot.io

# rules disables model calls while retaining provider credentials for later use
PLANNER_MODE=rules
